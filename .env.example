# ==============================================================
# AXIA KAIROS & AXIA ASSISTANT ENVIRONMENT CONFIGURATION
# ==============================================================

# 1. Anthropic API Settings
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model ID: default "claude-haiku-5-5" (or "claude-sonnet-5-5" for complex queries)
AI_MODEL=claude-haiku-5-5

# 2. Server Configuration
PORT=3001
NODE_ENV=development

# 3. Security & Admin Authentication
ADMIN_JWT_SECRET=axia-admin-super-secret-key-2026

# 4. Database (PostgreSQL)
# Auto-injected on Railway when PostgreSQL service is linked
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# 5. Frontend API Target (Vite)
# Points to your Railway backend URL in production, or localhost in development
VITE_API_URL=http://localhost:3001
