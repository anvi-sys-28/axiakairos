# Axia Kairos Frontend Environment Variables

# In Local Development:
# Leave blank (or comment out) to let Vite dev proxy route /api calls to http://localhost:3001
VITE_API_URL=

# In Cloudflare Pages Production Deployment:
# Set to your Railway backend URL (NO trailing slash)
# Example:
# VITE_API_URL=https://your-backend-production.up.railway.app
